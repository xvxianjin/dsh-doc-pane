{
  "name": "dsh-doc-pane",
  "version": "0.1.2",
  "license": "MIT",
  "author": "Xianjin Xv <1424177211@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xvxianjin/dsh-doc-pane.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "markdown",
    "editor",
    "prosemirror",
    "plugin"
  ],
  "type": "module",
  "description": "Open the Markdown document the agent is editing in a side panel: edit it, preview it, and rewrite a selection with AI plus a word-level diff.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.en.md",
    "recover-profile.cmd",
    "recover-profile.ps1",
    "vendor/editor.js",
    "tools/editor/build.mjs",
    "tools/editor/editor.cjs",
    "tools/editor/entry.js",
    "tools/editor/smoke.cjs",
    "tools/editor/package.json",
    "tools/editor/package-lock.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
